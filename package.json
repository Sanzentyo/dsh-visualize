{
  "name": "dsh-visualize",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Render interactive HTML visualizations inline in the DSH conversation, on desktop and mobile.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "skills/**/*.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-fs": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-working-directory": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-fs": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-working-directory": { "optional": true }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "visualize",
    "visualization",
    "html",
    "iframe"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanzentyo/dsh-visualize.git"
  },
  "homepage": "https://github.com/Sanzentyo/dsh-visualize#readme",
  "bugs": {
    "url": "https://github.com/Sanzentyo/dsh-visualize/issues"
  }
}
